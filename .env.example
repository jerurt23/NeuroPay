# Firebase Configuration (obtener desde Firebase Console > Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ────────────────────────────────────────────────────────────────────
#  Gmail API
# ────────────────────────────────────────────────────────────────────
#
#  ⛔ NUNCA pongas aqui un refresh token ni un client secret.
#     Todo lo que lleva prefijo VITE_ se compila dentro del bundle
#     publico y cualquiera puede leerlo en el navegador.
#     Un refresh token filtrado = acceso total a tu correo.
#
#  ✅ Esto si es seguro (OAuth public client):
VITE_GOOGLE_CLIENT_ID=

#  URL de TU backend, que guarda el refresh token cifrado.
#  En produccion debe ser HTTPS.
VITE_GMAIL_BACKEND_URL=