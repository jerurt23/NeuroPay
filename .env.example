# ────────────────────────────────────────────────────────────────────
#  FRONTEND DE NEUROPAY. Copia este archivo a .env (o .env.development.local).
# ────────────────────────────────────────────────────────────────────
#
#  ⛔ NUNCA pongas aqui un secreto (client secret, refresh token, clave de cifrado).
#     Todo lo que lleva prefijo VITE_ se compila dentro del bundle publico
#     y cualquiera puede leerlo en el navegador.
#
#  ✅ ID de cliente OAuth 2.0 tipo "Aplicación web". Es publico, no un secreto.
VITE_GOOGLE_CLIENT_ID=

#  URL de la API de NEUROPAY: el servidor en Render, o http://localhost:8787 en desarrollo.
#  En produccion debe ser HTTPS.
VITE_API_URL=
