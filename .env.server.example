# ────────────────────────────────────────────────────────────────────
#  API DE NEUROPAY. Copia este archivo a .env (en tu PC) o configura estas
#  mismas variables en Render. NUNCA subas .env a git.
# ────────────────────────────────────────────────────────────────────

PORT=8787

# Origenes que pueden llamar a la API, separados por coma.
# Deben estar tambien en "Orígenes JavaScript autorizados" de Google.
ALLOWED_ORIGINS=http://localhost:3000,https://neuropay-2fc4d.web.app

# Correos que pueden entrar a NEUROPAY y usar Gmail, separados por coma.
# Vacío = entra cualquier cuenta de Google verificada (el filtro lo pone Google
# con sus "Usuarios de prueba"). Con correos, solo esos entran.
ALLOWED_EMAILS=

# Google OAuth: cliente tipo "Aplicación web".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave para cifrar los tokens de Gmail (64 caracteres hexadecimales):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la cambias, las cuentas de Gmail conectadas dejan de funcionar y hay que reconectarlas.
TOKEN_ENCRYPTION_KEY=

# MongoDB Atlas: cadena de conexión (mongodb+srv://...).
MONGODB_URI=
