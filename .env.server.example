# ────────────────────────────────────────────────────────────────────
#  SERVIDOR GMAIL. Copia este archivo a .env (en tu PC) o configura estas
#  mismas variables en Render. NUNCA subas .env a git.
# ────────────────────────────────────────────────────────────────────

PORT=8787

# Origenes que pueden llamar al servidor, separados por coma.
# Deben estar tambien en "Orígenes JavaScript autorizados" de Google.
ALLOWED_ORIGINS=http://localhost:3000,https://neuropay-2fc4d.web.app

# Correos de la app que pueden usar Gmail, separados por coma. Vacío = nadie.
GMAIL_ALLOWED_EMAILS=

# Firebase: los mismos valores que en el .env del frontend.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# Google OAuth: cliente tipo "Aplicación web".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave para cifrar los tokens de Gmail (64 caracteres hexadecimales):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la cambias, las cuentas conectadas dejan de funcionar y hay que reconectarlas.
TOKEN_ENCRYPTION_KEY=

# MongoDB Atlas: cadena de conexión (mongodb+srv://...).
MONGODB_URI=
