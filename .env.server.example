# ────────────────────────────────────────────────────────────────────
#  BACKEND - Copia este archivo a .env y rellenalo.
#  NUNCA subas .env a git (ya esta en .gitignore).
# ────────────────────────────────────────────────────────────────────

# Puerto del backend
PORT=8787

# Origenes autorizados a llamar este servidor (separados por coma).
# Debe coincidir EXACTAMENTE con el dominio desde el que sirves la app.
ALLOWED_ORIGINS=http://localhost:3000

# ── Firebase (para validar el idToken del usuario) ──────────────────
# Son los MISMOS valores de tu .env del frontend.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# ── Google OAuth 2.0 ───────────────────────────────────────────────
# Client ID y Client Secret de Google Cloud Console > APIs & Services >
# Credentials > OAuth 2.0 Client IDs.
#
# Estos van SOLO aqui, nunca en el frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Debe coincidir con el "Authorized redirect URI" de Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/callback

# ── Cifrado de tokens ──────────────────────────────────────────────
# Genera una clave de 32 bytes con este comando:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Si la cambias despues, los tokens guardados dejan de descifrarse
# y habra que reconectar Gmail.
TOKEN_ENCRYPTION_KEY=